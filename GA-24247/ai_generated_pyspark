        df_exp_get_tp_value.printSchema()
        df_exp_get_tp_value.show(5, truncate=False)

        # T3 — exp_set_default_Tp_values
        logger.info("Processing T3: exp_set_default_Tp_values")
        df_exp_set_default_tp_values = df_exp_get_tp_value.withColumn(
            "o_Status_Tp",
            F.when(F.col("Status_Tp").isNotNull(), F.col("Status_Tp")).otherwise(F.lit(-2))
        )
        df_exp_set_default_tp_values.createOrReplaceTempView("exp_set_default_Tp_values")
        logger.info(f"T3 row count: {df_exp_set_default_tp_values.count()}")
        df_exp_set_default_tp_values.printSchema()
        df_exp_set_default_tp_values.show(5, truncate=False)

        # T4 — Shortcut_to_InteractionStatus (Target Write)
