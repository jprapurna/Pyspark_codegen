                OR (XREF.SOURCE_CD IN ({PARAMS['$$excluded_sources']}, {PARAMS['$$IGS_excluded_source']})
                    AND SystemResult_Cd <> 'Planned Event')
            ) VIR_TBL
        ) P
        WHERE P.CURR_ROW <> P.PREV_ROW
            AND NOT EXISTS (
                SELECT ''
