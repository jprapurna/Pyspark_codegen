        df_exp_get_tp_value = df_sq_interaction_event.withColumn(
            "o_Status_Tp",
            F.lit(-2)  # Default value for lookup fallback
        ).withColumn(
            "o_InteractionStatus_Id",
            F.expr("CAST(SUBSTR(TO_CHAR(LoadEvent_Id), 0, LENGTH(TO_CHAR(LoadEvent_Id)) - 1) || SUBSTR('000000000000000000', 0, 18 - LENGTH(TO_CHAR(LoadEvent_Id)) + 1) AS DECIMAL(18,0)) + NUMBER_SEQ")
        ).withColumn(
            "o_TransactionEffective_Dt",
            F.to_date(F.date_format(F.col("TransactionEffective_Dt"), "yyyy-MM-dd"), "yyyy-MM-dd")
