def apply_lookup_with_fallback(df, lookup_table, lookup_key, lookup_value, default_value):
    """Perform a lookup with fallback to default value."""
    lookup_df = spark.table(lookup_table).select(lookup_key, lookup_value)
    return df.join(lookup_df, lookup_key, "left").withColumn(
        lookup_value, F.coalesce(F.col(lookup_value), F.lit(default_value))
    )

def require_cols(df, required_cols):
    """Ensure required columns exist in DataFrame."""
    missing_cols = [col for col in required_cols if col not in df.columns]
    if missing_cols:
        raise ValueError(f"Missing required columns: {missing_cols}")

