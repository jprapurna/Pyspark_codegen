                VIR_TBL.Interaction_Id AS Interaction_Id,
                ROW_NUMBER() OVER(PARTITION BY InteractionGroup_Id ORDER BY InteractionGroup_Id, Sequence_It) AS Row_Num,
                TO_CHAR(VIR_TBL.InteractionGroup_Id) || VIR_TBL.SystemResult_Cd AS Curr_Row,
                COALESCE(
                    MIN(TO_CHAR(VIR_TBL.InteractionGroup_Id) || VIR_TBL.SystemResult_Cd)
                    OVER(PARTITION BY InteractionGroup_Id ORDER BY InteractionGroup_Id, Sequence_It ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING),
                    0
                ) AS Prev_Row
            FROM (
                SELECT
                    IE.InteractionGroup_Id,
                    IE.SystemResult_Cd,
                    IE.TransactionEffective_Dt,
                    IE.Transaction_Ts,
                    IE.Sequence_It,
                    IE.Source_Cd,
