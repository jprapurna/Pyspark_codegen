                                WHEN IE.ActionType_Tp = 12 THEN 'View'
                                WHEN IE.ActionType_Tp = 5 AND IE.Action_Tp = 26 THEN 'Qcrtd'
                                WHEN IE.ActionType_Tp = 5 AND IE.Action_Tp IN (27, 28, 29) THEN 'Qabdn'
                                ELSE 'Notdef'
                            END
