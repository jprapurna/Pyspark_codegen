        logger.info("Processing T1: SQ_InteractionEvent")
        sql_query = """
        SELECT
            ROW_NUMBER() OVER(ORDER BY P.InteractionGroup_Id, P.Sequence_It) AS NUMBER_SEQ,
            P.InteractionGroup_Id,
            P.Status_Cd,
            P.TransactionEffective_Dt,
            P.Transaction_Ts,
            P.Sequence_It,
            P.Source_Cd,
            P.LoadEvent_Id,
            P.Interaction_Id
        FROM (
            SELECT
                VIR_TBL.InteractionGroup_Id AS InteractionGroup_Id,
