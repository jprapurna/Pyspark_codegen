import logging
from pyspark.sql import functions as F

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

try:
    # Step 1: Load source data from Unity Catalog
    logger.info("Loading source data from Unity Catalog table: catalog.source_db.WRK_BIRP_NISS_APRM_DETL")
    source_df = spark.table("catalog.source_db.WRK_BIRP_NISS_APRM_DETL")

    # Step 2: Apply transformations as per lineage plan
    logger.info("Applying transformations to source data")
    
    # Example transformation: Filter rows where 'NISS_CMPNY_CD' is not null
    transformed_df = source_df.filter(F.col("NISS_CMPNY_CD").isNotNull())
    
    # Example transformation: Add a derived column 'DERIVED_RDRVR_AGE' based on 'RDRVR_DT_OF_BRTH'
    transformed_df = transformed_df.withColumn(
        "DERIVED_RDRVR_AGE",
        F.when(F.col("RDRVR_DT_OF_BRTH").isNotNull(), F.year(F.current_date()) - F.year(F.to_date(F.col("RDRVR_DT_OF_BRTH"), "yyyy-MM-dd")))
         .otherwise(None)
    )
    
    # Example transformation: Aggregate data to calculate total premium amount grouped by 'LOB'
    aggregated_df = transformed_df.groupBy("LOB").agg(F.sum("TTL_WRITTN_PREM_AMT").alias("TOTAL_PREMIUM_AMOUNT"))
    
    # Example transformation: Join with another Unity Catalog table for enrichment
    logger.info("Joining with enrichment table: catalog.enrichment_db.NISS_CLASS_CD_MAPPING")
    enrichment_df = spark.table("catalog.enrichment_db.NISS_CLASS_CD_MAPPING")
    final_df = aggregated_df.join(enrichment_df, aggregated_df["LOB"] == enrichment_df["LOB"], "left")

    # Step 3: Write transformed data to Unity Catalog target table
    logger.info("Writing transformed data to Unity Catalog target table: catalog.target_db.FDR_LIB_WRK_BIRP_NISS_APRM_DETL")
    spark.sql("DROP TABLE IF EXISTS catalog.target_db.FDR_LIB_WRK_BIRP_NISS_APRM_DETL")
    final_df.write.format("delta").mode("overwrite").saveAsTable("catalog.target_db.FDR_LIB_WRK_BIRP_NISS_APRM_DETL")

    logger.info("ETL process completed successfully")

except Exception as e:
    logger.error(f"An error occurred during the ETL process: {str(e)}")
    raise


import logging
from pyspark.sql import functions as F

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

try:
    # Step 1: Load source data from Unity Catalog table
    logger.info("Loading source data from Unity Catalog table...")
    source_table = "catalog.source_db.FDR_WRK_BIRP_NISS_APRM_DETL"
    source_df = spark.sql(f"""
        SELECT
            NISS_APRM_DETL_SK,
            LTRIM(RTRIM(ST_ABBR)) AS ST_ABBR,
            LTRIM(RTRIM(ST_CD)) AS ST_CD,
            LTRIM(RTRIM(RATNG_CMPY_CD)) AS RATNG_CMPY_CD,
            LTRIM(RTRIM(MLT_CAR_IND)) AS MLT_CAR_IND,
            LTRIM(RTRIM(RT_CLS)) AS RT_CLS,
            LTRIM(RTRIM(FINAL_RDRVR_AGE)) AS FINAL_RDRVR_AGE,
            LTRIM(RTRIM(GENDR)) AS GENDR,
            LTRIM(RTRIM(MRTL_STAT)) AS MRTL_STAT,
            LTRIM(RTRIM(AUTO_USE_CD)) AS AUTO_USE_CD,
            LTRIM(RTRIM(MILES_TO_WRK)) AS MILES_TO_WRK,
            LTRIM(RTRIM(GOOD_STDNT_IND)) AS GOOD_STDNT_IND,
            LTRIM(RTRIM(DRVR_TRNG_IND)) AS DRVR_TRNG_IND,
            LTRIM(RTRIM(SOI_TYP)) AS SOI_TYP,
            LTRIM(RTRIM(ACCTNG_LOB)) AS ACCTNG_LOB,
            LTRIM(RTRIM(CVG_TYP_CD)) AS CVG_TYP_CD,
            REC_EXCPN_IND,
            REC_EXCPN_RSN_DESC
        FROM {source_table}
        WHERE ST_ABBR NOT IN ('NY', 'NJ') AND SOURCE_IND_DERIVED = 'FARMERS'
    """)
    logger.info(f"Source data loaded successfully with {source_df.count()} records.")

    # Step 2: Apply transformation logic
    logger.info("Applying transformation logic...")
    transformed_df = source_df.withColumn(
        "NISS_CLASS_CD_FL",
        F.when(
            (F.col("ST_ABBR") == "FL") & (F.col("FINAL_RDRVR_AGE") != " "),
            F.when(
                (F.col("FINAL_RDRVR_AGE").cast("int") < 25) &
                (F.col("RATNG_CMPY_CD") == "K") &
                (F.col("MLT_CAR_IND") == "N") &
                ((F.col("RT_CLS").substr(-1, 1) == "5") | F.col("RT_CLS").isin("5M", "9", "5F", "2F", "2M")) &
                (F.col("MRTL_STAT") == "M") &
                (F.col("AUTO_USE_CD") != "FRM"),
                "1620"
            ).when(
                (F.col("FINAL_RDRVR_AGE").cast("int") < 25) &
                (F.col("RATNG_CMPY_CD") == "K") &
                (F.col("MLT_CAR_IND") == "N") &
                ((F.col("RT_CLS").substr(-1, 1) == "5") | F.col("RT_CLS").isin("5M", "9", "5F", "2F", "2M")) &
                (F.col("MRTL_STAT") == "M") &
                (F.col("AUTO_USE_CD") == "FRM"),
                "1623"
            ).otherwise("")
        ).otherwise("")
    )
    logger.info("Transformation logic applied successfully.")

    # Step 3: Write transformed data to Unity Catalog target table
    logger.info("Writing transformed data to Unity Catalog target table...")
    target_table = "catalog.target_db.NISS_CLASSIFICATION"
    spark.sql(f"DROP TABLE IF EXISTS {target_table}")
    transformed_df.write.format("delta").mode("overwrite").saveAsTable(target_table)
    logger.info(f"Transformed data written successfully to {target_table}.")

except Exception as e:
    logger.error(f"An error occurred during the ETL process: {str(e)}")
    raise


