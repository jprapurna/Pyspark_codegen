import logging
from pyspark.sql.functions import col, expr

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

try:
    # Load source data from Unity Catalog
    logger.info("Loading source data from Unity Catalog...")
    source_df = spark.table("catalog.source_db.source_table")

    # Apply transformations based on the lineage plan
    logger.info("Applying transformations...")
    
    # Passthrough fields
    transformed_df = source_df.select(
        col("NISS_APRM_DETL_SK"),
        col("i_REC_EXCPN_IND"),
        col("REC_EXCPTN_RSN_DESC_ZIP"),
        expr("CASE WHEN I_AUTO_USE_CD IS NULL THEN '' ELSE I_AUTO_USE_CD END").alias("AUTO_USE_CD"),
        expr("CAST(AGE AS INT)").alias("IAGE"),
        expr("CAST(MILES_TO_WRK AS INT)").alias("IMILES_TO_WRK"),
        expr("""
            CASE 
                WHEN NOT (ST_ABBR IN ('NY', 'NJ', 'NC', 'AR', 'SD', 'PA')) AND ACCTNG_LOB = '1923D' THEN '941400'
                WHEN ST_ABBR IN ('AR') AND ACCTNG_LOB = '191' THEN '946400'
                WHEN ST_ABBR IN ('SD') AND ACCTNG_LOB = '1923D' THEN '946400'
                WHEN ST_ABBR IN ('PA') AND ACCTNG_LOB = '191' AND CVG_TYP_CD IN ('35043', '35046') THEN '999700'
                ELSE '??????'
            END
        """).alias("v_CLASS_CD_Indemnity"),
        expr("""
            CASE 
                WHEN NOT (ST_ABBR IN ('NY', 'NJ', 'NC', 'MI', 'MT', 'PA')) AND 
                     RATNG_CMPY_CD IN ('N', 'B', 'K', 'J', 'L') AND 
                     ST_CD IN ('04', '07', '08', '10', '11', '12', '13', '14', '15', '16', '18', '21', '22', '25', '34', '36', '50', '66', '67', '68', '73', '75', '76', '79', '88', '44', '91') THEN
                    CASE 
                        WHEN IAGE >= 65 THEN '1700'
                        WHEN IAGE >= 25 AND IAGE < 65 AND NOT (AUTO_USE_CD IN ('SLS')) THEN
                            CASE 
                                WHEN MLT_CAR_IND = 'N' THEN '1200'
                                ELSE '1202'
                            END
                        WHEN IAGE < 25 THEN
                            CASE 
                                WHEN GENDR = 'M' THEN
                                    CASE 
                                        WHEN MLT_CAR_IND = 'N' THEN '1600'
                                        ELSE '1602'
                                    END
                                WHEN GENDR = 'F' THEN
                                    CASE 
                                        WHEN MLT_CAR_IND = 'N' THEN '1640'
                                        ELSE '1642'
                                    END
                                WHEN LTRIM(RTRIM(GENDR)) IN ('U', '', 'X') OR GENDR IS NULL THEN
                                    CASE 
                                        WHEN MLT_CAR_IND = 'N' THEN 'E600'
                                        ELSE 'E602'
                                    END
                                ELSE ''
                            END
                        WHEN TO_CHAR(IAGE) = '' OR IAGE IS NULL OR LTRIM(RTRIM(GENDR)) = '' OR GENDR IS NULL AND NOT (AUTO_USE_CD IN ('SLS')) THEN
                            CASE 
                                WHEN MLT_CAR_IND = 'Y' THEN 'E202'
                                ELSE '1200'
                            END
                        ELSE ''
                    END
                ELSE ''
            END
        """).alias("v_CLASS_CD_Auto_1"),
        expr("CASE WHEN ST_ABBR = 'FL' THEN NISS_CLASS_CD_FL ELSE '' END").alias("v_CLASS_CD_Auto_1A"),
        expr("""
            CASE 
                WHEN NOT (ST_ABBR IN ('NY', 'NJ', 'NC', 'MI', 'MT', 'PA')) AND 
                     IAGE >= 25 AND IAGE < 65 AND NOT (AUTO_USE_CD IN ('HOP', 'HPS', 'PLS', 'STG', 'COM', 'FRM')) THEN
                    CASE 
                        WHEN MLT_CAR_IND = 'N' THEN '1400'
                        ELSE '1402'
                    END
                ELSE ''
            END
        """).alias("v_CLASS_CD_Auto_2"),
        expr("""
            CASE 
                WHEN NOT (ST_ABBR IN ('NY', 'NJ', 'NC', 'MI', 'MT', 'PA')) AND 
                     RATNG_CMPY_CD IN ('P', 'S', 'E') THEN
                    CASE 
                        WHEN IAGE >= 25 AND IAGE < 65 THEN
                            CASE 
                                WHEN AUTO_USE_CD IN ('HOP', 'HPS', 'PLS', 'STG', '#') THEN
                                    CASE 
                                        WHEN MLT_CAR_IND = 'N' THEN '1210'
                                        ELSE '1212'
                                    END
                                WHEN AUTO_USE_CD = 'FRM' THEN
                                    CASE 
                                        WHEN MLT_CAR_IND = 'N' THEN '1213'
                                        ELSE '1211'
                                    END
                                WHEN AUTO_USE_CD = 'COM' THEN
                                    CASE 
                                        WHEN IMILES_TO_WRK < 10 THEN
                                            CASE 
                                                WHEN MLT_CAR_IND = 'N' THEN '1220'
                                                ELSE '1222'
                                            END
                                        WHEN IMILES_TO_WRK >= 10 THEN
                                            CASE 
                                                WHEN MLT_CAR_IND = 'N' THEN '1230'
                                                ELSE '1232'
                                            END
                                        ELSE ''
                                    END
                                ELSE ''
                            END
                        WHEN IAGE < 25 THEN
                            CASE 
                                WHEN RT_CLS IN ('08', '18', '28', '38', '48', '58', 'M6', 'M8', 'N6', 'N8') THEN
                                    CASE 
                                        WHEN AUTO_USE_CD = 'FRM' THEN
                                            CASE 
                                                WHEN MLT_CAR_IND = 'N' THEN '1613'
                                                ELSE '1611'
                                            END
                                        ELSE
                                            CASE 
                                                WHEN MLT_CAR_IND = 'N' THEN '1610'
                                                ELSE '1612'
                                            END
                                    END
                                WHEN (SUBSTR(RT_CLS, 2, 1) = '5' OR RT_CLS = '5') AND MRTL_STAT = 'M' THEN
                                    CASE 
                                        WHEN AUTO_USE_CD = 'FRM' THEN
                                            CASE 
                                                WHEN MLT_CAR_IND = 'N' THEN '1623'
                                                ELSE '1621'
                                            END
                                        ELSE
                                            CASE 
                                                WHEN MLT_CAR_IND = 'N' THEN '1620'
                                                ELSE '1622'
                                            END
                                    END
                                ELSE ''
                            END
                        ELSE ''
                    END
                ELSE ''
            END
        """).alias("v_CLASS_CD_Auto_3")
    )

    # Write transformed data to Unity Catalog target table
    logger.info("Writing transformed data to Unity Catalog target table...")
    spark.sql("DROP TABLE IF EXISTS catalog.target_db.target_table")
    transformed_df.write.format("delta").mode("overwrite").saveAsTable("catalog.target_db.target_table")

    logger.info("ETL process completed successfully.")

except Exception as e:
    logger.error(f"An error occurred during the ETL process: {e}")
    raise