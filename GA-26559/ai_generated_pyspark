        # Calculate new ROW_WID
        df = df.withColumn(
            "V1",
            F.when(F.col("V2") == 0, F.col("ROW_WID")).otherwise(F.col("V2"))
        ).withColumn(
            "V2",
            F.col("V1") + F.lit(1)
        ).withColumn(
            "ROW_WID",
