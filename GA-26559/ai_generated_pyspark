class CDMBatchIDMapplet:
    """
    ETL Pipeline for processing batch IDs.

    Sources: CDM.CDM_BATCH_CTRLID
    Targets: o_BATCH_ID
    Transformation Logic: Fetch maximum batch ID, perform lookup, handle null values, and output processed batch ID.
    """

    def __init__(self, spark: SparkSession, config: Dict):
        self.spark = spark
        self.config = config
        self._configure_spark()

    def _configure_spark(self):
        """
        Set Spark configurations for optimal performance.
        """
        configs = {
            "spark.sql.adaptive.enabled": "true",
            "spark.sql.adaptive.coalescePartitions.enabled": "true",
            "spark.sql.shuffle.partitions": str(self.config.get('shuffle_partitions', 200))
        }

        for key, value in configs.items():
            self.spark.conf.set(key, value)

    def extract(self) -> DataFrame:
        """
        Extract data from source table.

        Optimizations:
        - Custom SQL query for filtering and grouping.
        - Column trimming and formatting.
        """
        logger.info("Starting data extraction")

        table_name = self.config.get('source_table', 'CDM.CDM_BATCH_CTRLID')
        local_file_path = self.config.get('source_local_path', None)

        # Read source table
        df = read_table(
            table_name=table_name,
            local_file_path=local_file_path
        )

        # Apply custom SQL query
        df = df.selectExpr(
            "MAX(BATCH_ID) as BATCH_ID",
            "ltrim(rtrim(SOURCE_NAME)) as SOURCE_NAME"
        ).filter(F.col("STATUS") == self.config.get('status_running', 'RUNNING')).groupBy("SOURCE_NAME").agg(
            F.max("BATCH_ID").alias("BATCH_ID")
        )

        log_df_info(df, "Source: CDM_BATCH_CTRLID")
        logger.info("Data extraction complete")
        return df

    def lookup(self, df: DataFrame) -> DataFrame:
        """
        Perform lookup transformation to fetch maximum batch ID for the given source name.

        Optimizations:
        - Broadcast join for lookup table.
        """
        logger.info("Performing lookup transformation")

        lookup_table_name = self.config.get('lookup_table', 'CDM.CDM_BATCH_CTRLID')
        lookup_local_path = self.config.get('lookup_local_path', None)

        # Read lookup table
        lookup_df = read_table(
            table_name=lookup_table_name,
            local_file_path=lookup_local_path
        ).selectExpr(
            "MAX(BATCH_ID) as BATCH_ID",
            "ltrim(rtrim(SOURCE_NAME)) as SOURCE_NAME"
        ).filter(F.col("STATUS") == self.config.get('status_running', 'RUNNING')).groupBy("SOURCE_NAME").agg(
            F.max("BATCH_ID").alias("BATCH_ID")
        )

        # Perform broadcast join
        df = df.join(
            F.broadcast(lookup_df),
            df["SOURCE_NAME"] == lookup_df["SOURCE_NAME"],
            "left"
        ).select(
            df["SOURCE_NAME"],
            lookup_df["BATCH_ID"].alias("LKP_BATCH_ID")
        )

        log_df_info(df, "Lookup Transformation")
        return df

