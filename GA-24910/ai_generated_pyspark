# Helper functions
def apply_lookup_with_fallback(df, lookup_table, key_col, value_col, default_value):
    """
    Perform a left join lookup and fallback to default value if no match is found.
    """
    lookup_df = spark.table(lookup_table).select(key_col, value_col)
    return df.join(lookup_df, df[key_col] == lookup_df[key_col], "left_outer") \
             .withColumn(value_col, F.coalesce(F.col(value_col), F.lit(default_value)))

def substitute_params(sql_query):
    """
    Substitute $$variables in SQL query with PARAMS dictionary values.
    """
    for param, value in PARAMS.items():
        sql_query = sql_query.replace(param, value)
    return sql_query

