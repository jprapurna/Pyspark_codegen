import logging
from pyspark.sql.functions import col, expr, lit, when, concat

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

try:
    # Load source data from Unity Catalog table
    logger.info("Loading source data from Unity Catalog table...")
    source_df = spark.table("catalog.source_db.source_table")

    # Apply transformations based on the mapping data
    logger.info("Applying transformations...")
    transformed_df = (
        source_df
        # Passthrough fields
        .select(
            col("NISS_APRM_DETL_SK"),
            col("i_REC_EXCPN_IND"),
            col("REC_EXCPTN_RSN_DESC_ZIP"),
            col("ST_ABBR"),
            col("ST_CD"),
            col("RATNG_CMPY_CD"),
            col("MLT_CAR_IND"),
            col("RT_CLS"),
            col("AGE"),
            col("GENDR"),
            col("MRTL_STAT"),
            col("I_AUTO_USE_CD"),
            col("MILES_TO_WRK"),
            col("GOOD_STDNT_IND"),
            col("DRVR_TRNG_IND"),
            col("SOI_TYP"),
            col("ACCTNG_LOB"),
            col("CVG_TYP_CD"),
            col("NISS_CLASS_CD_FL")
        )
        # Transformations
        .withColumn("AUTO_USE_CD", expr("CASE WHEN I_AUTO_USE_CD IS NULL THEN '' ELSE I_AUTO_USE_CD END"))
        .withColumn("IAGE", expr("CAST(AGE AS INT)"))
        .withColumn("IMILES_TO_WRK", expr("CAST(MILES_TO_WRK AS INT)"))
        .withColumn(
            "v_CLASS_CD_Indemnity",
            expr("""
                CASE 
                    WHEN NOT ST_ABBR IN ('NY', 'NJ', 'NC', 'AR', 'SD', 'PA') AND ACCTNG_LOB = '1923D' THEN '941400'
                    WHEN ST_ABBR = 'AR' AND ACCTNG_LOB = '191' THEN '946400'
                    WHEN ST_ABBR = 'SD' AND ACCTNG_LOB = '1923D' THEN '946400'
                    WHEN ST_ABBR = 'PA' AND ACCTNG_LOB = '191' AND CVG_TYP_CD IN ('35043', '35046') THEN '999700'
                    ELSE '??????'
                END
            """)
        )
        .withColumn(
            "v_CLASS_CD_Auto_1",
            expr("""
                CASE 
                    WHEN NOT ST_ABBR IN ('NY', 'NJ', 'NC', 'MI', 'MT', 'PA') AND 
                         RATNG_CMPY_CD IN ('N', 'B', 'K', 'J', 'L') AND 
                         ST_CD IN ('04', '07', '08', '10', '11', '12', '13', '14', '15', '16', '18', '21', '22', '25', '34', '36', '50', '66', '67', '68', '73', '75', '76', '79', '88', '44', '91') THEN
                         CASE 
                             WHEN IAGE >= 65 THEN '1700'
                             WHEN IAGE >= 25 AND IAGE < 65 AND AUTO_USE_CD != 'SLS' THEN
                                 CASE 
                                     WHEN MLT_CAR_IND = 'N' THEN '1200'
                                     ELSE '1202'
                                 END
                             WHEN IAGE < 25 THEN
                                 CASE 
                                     WHEN GENDR = 'M' THEN
                                         CASE 
                                             WHEN MLT_CAR_IND = 'N' THEN '1600'
                                             ELSE '1602'
                                         END
                                     WHEN GENDR = 'F' THEN
                                         CASE 
                                             WHEN MLT_CAR_IND = 'N' THEN '1640'
                                             ELSE '1642'
                                         END
                                     ELSE
                                         CASE 
                                             WHEN MLT_CAR_IND = 'N' THEN 'E600'
                                             ELSE 'E602'
                                         END
                                 END
                             ELSE ''
                         END
                    ELSE ''
                END
            """)
        )
        .withColumn("v_CLASS_CD_Auto_1A", expr("CASE WHEN ST_ABBR = 'FL' THEN NISS_CLASS_CD_FL ELSE '' END"))
        .withColumn(
            "v_CLASS_CD_Auto_2",
            expr("""
                CASE 
                    WHEN NOT ST_ABBR IN ('NY', 'NJ', 'NC', 'MI', 'MT', 'PA') AND 
                         IAGE >= 25 AND IAGE < 65 AND 
                         AUTO_USE_CD NOT IN ('HOP', 'HPS', 'PLS', 'STG', 'COM', 'FRM') THEN
                         CASE 
                             WHEN MLT_CAR_IND = 'N' THEN '1400'
                             ELSE '1402'
                         END
                    ELSE ''
                END
            """)
        )
        .withColumn(
            "v_CLASS_CD_Auto_3",
            expr("""
                CASE 
                    WHEN NOT ST_ABBR IN ('NY', 'NJ', 'NC', 'MI', 'MT', 'PA') AND 
                         RATNG_CMPY_CD IN ('P', 'S', 'E') THEN
                         CASE 
                             WHEN IAGE >= 25 AND IAGE < 65 THEN
                                 CASE 
                                     WHEN AUTO_USE_CD IN ('HOP', 'HPS', 'PLS', 'STG', '#') THEN
                                         CASE 
                                             WHEN MLT_CAR_IND = 'N' THEN '1210'
                                             ELSE '1212'
                                         END
                                     WHEN AUTO_USE_CD = 'FRM' THEN
                                         CASE 
                                             WHEN MLT_CAR_IND = 'N' THEN '1213'
                                             ELSE '1211'
                                         END
                                     WHEN AUTO_USE_CD = 'COM' THEN
                                         CASE 
                                             WHEN IMILES_TO_WRK < 10 THEN
                                                 CASE 
                                                     WHEN MLT_CAR_IND = 'N' THEN '1220'
                                                     ELSE '1222'
                                                 END
                                             WHEN IMILES_TO_WRK >= 10 THEN
                                                 CASE 
                                                     WHEN MLT_CAR_IND = 'N' THEN '1230'
                                                     ELSE '1232'
                                                 END
                                             ELSE ''
                                         END
                                     ELSE ''
                                 END
                             ELSE ''
                         END
                    ELSE ''
                END
            """)
        )
        .withColumn("NISS_CLASS_CD", expr("CASE WHEN substr(trim(v_NISS_CLASS_CD), 1, 4) = '????' OR substr(v_NISS_CLASS_CD, 5, 6) = '??' THEN '??????' ELSE v_NISS_CLASS_CD END"))
        .withColumn("REC_EXCPN_IND", expr("CASE WHEN i_REC_EXCPN_IND = 'Y' OR REC_EXCP_IND = 'Y' THEN 'Y' ELSE '' END"))
        .withColumn("REC_EXCP_DESC", concat(col("REC_EXCPTN_RSN_DESC_ZIP"), col("REC_EXCP_DESC_CLASS")))
    )

    # Write transformed data to Unity Catalog target table
    logger.info("Writing transformed data to Unity Catalog target table...")
    spark.sql("DROP TABLE IF EXISTS catalog.target_db.target_table")
    transformed_df.write.format("delta").mode("overwrite").saveAsTable("catalog.target_db.target_table")

    logger.info("ETL process completed successfully.")

except Exception as e:
    logger.error(f"An error occurred during the ETL process: {e}")
    raise