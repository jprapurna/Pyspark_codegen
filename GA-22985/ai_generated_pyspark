import logging
from pyspark.sql import functions as F

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

try:
    # Step 1: Load source data from Unity Catalog table
    logger.info("Loading source data from Unity Catalog table...")
    source_df = spark.sql("""
        SELECT
            NISS_APRM_DETL_SK,
            LTRIM(RTRIM(ST_ABBR)) AS ST_ABBR,
            LTRIM(RTRIM(ST_CD)) AS ST_CD,
            LTRIM(RTRIM(RATNG_CMPY_CD)) AS RATNG_CMPY_CD,
            LTRIM(RTRIM(MLT_CAR_IND)) AS MLT_CAR_IND,
            LTRIM(RTRIM(RT_CLS)) AS RT_CLS,
            LTRIM(RTRIM(FINAL_RDRVR_AGE)) AS FINAL_RDRVR_AGE,
            LTRIM(RTRIM(GENDR)) AS GENDR,
            LTRIM(RTRIM(MRTL_STAT)) AS MRTL_STAT,
            LTRIM(RTRIM(AUTO_USE_CD)) AS AUTO_USE_CD,
            LTRIM(RTRIM(MILES_TO_WRK)) AS MILES_TO_WRK,
            LTRIM(RTRIM(GOOD_STDNT_IND)) AS GOOD_STDNT_IND,
            LTRIM(RTRIM(DRVR_TRNG_IND)) AS DRVR_TRNG_IND,
            LTRIM(RTRIM(SOI_TYP)) AS SOI_TYP,
            LTRIM(RTRIM(ACCTNG_LOB)) AS ACCTNG_LOB,
            LTRIM(RTRIM(CVG_TYP_CD)) AS CVG_TYP_CD,
            REC_EXCPN_IND,
            REC_EXCPN_RSN_DESC
        FROM catalog.source_db.source_table
        WHERE ST_ABBR NOT IN ('NY', 'NJ') AND SOURCE_IND_DERIVED = 'FARMERS'
    """)
    logger.info("Source data loaded successfully.")

    # Step 2: Apply transformation logic
    logger.info("Applying transformation logic...")
    transformed_df = source_df.withColumn(
        "NISS_CLASS_CD_FL",
        F.when(
            (F.col("ST_ABBR") == "FL") & (F.col("FINAL_RDRVR_AGE") != " "),
            F.when(
                (F.col("FINAL_RDRVR_AGE").cast("int") < 25) &
                (F.col("RATNG_CMPY_CD") == "K") &
                (F.col("MLT_CAR_IND") == "N") &
                ((F.col("RT_CLS").substr(-1, 1) == "5") | (F.col("RT_CLS").isin("5M", "9", "5F", "2F", "2M"))) &
                (F.col("MRTL_STAT") == "M") &
                (F.col("AUTO_USE_CD") != "FRM"),
                "1620"
            ).when(
                (F.col("FINAL_RDRVR_AGE").cast("int") < 25) &
                (F.col("RATNG_CMPY_CD") == "K") &
                (F.col("MLT_CAR_IND") == "N") &
                ((F.col("RT_CLS").substr(-1, 1) == "5") | (F.col("RT_CLS").isin("5M", "9", "5F", "2F", "2M"))) &
                (F.col("MRTL_STAT") == "M") &
                (F.col("AUTO_USE_CD") == "FRM"),
                "1623"
            ).otherwise("")
        ).otherwise("")
    )
    logger.info("Transformation logic applied successfully.")

    # Step 3: Write transformed data to Unity Catalog target table
    logger.info("Writing transformed data to Unity Catalog target table...")
    spark.sql("DROP TABLE IF EXISTS catalog.target_db.target_table")
    transformed_df.write.format("delta").mode("overwrite").saveAsTable("catalog.target_db.target_table")
    logger.info("Transformed data written successfully.")

except Exception as e:
    logger.error(f"An error occurred during the ETL process: {e}")
    raise


import logging
from pyspark.sql.functions import col

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

try:
    # Step 1: Load source data from Unity Catalog table
    logger.info("Loading source data from Unity Catalog table: catalog.source_db.source_table")
    source_df = spark.table("catalog.source_db.source_table")

    # Step 2: Apply transformations based on the lineage plan
    logger.info("Applying transformations as per the lineage plan")

    # Transformation: Passthrough fields without change
    transformed_df = source_df.select(
        col("NISS_APRM_DETL_SK"),
        col("NISS_CLASS_CD"),
        col("REC_EXCP_IND"),
        col("REC_EXCP_DESC")
    )

    # Transformation: Update Strategy Expression (DD_UPDATE)
    # Assuming DD_UPDATE means updating records based on some condition
    # For demonstration, let's assume we update NISS_CLASS_CD to 'UPDATED_CLASS' where REC_EXCP_IND is 'Y'
    transformed_df = transformed_df.withColumn(
        "NISS_CLASS_CD",
        col("NISS_CLASS_CD").when(col("REC_EXCP_IND") == "Y", "UPDATED_CLASS").otherwise(col("NISS_CLASS_CD"))
    )

    # Step 3: Write the transformed data to Unity Catalog target table
    target_table = "catalog.target_db.target_table"
    logger.info(f"Dropping existing target table if it exists: {target_table}")
