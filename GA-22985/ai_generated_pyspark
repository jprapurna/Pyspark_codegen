    logger.info("Loading source data from Unity Catalog table: catalog.source_db.WRK_BIRP_NISS_APRM_DETL")
    source_df = spark.table("catalog.source_db.WRK_BIRP_NISS_APRM_DETL")

    # Step 2: Apply transformations as per lineage plan
    logger.info("Applying transformations to source data")
    
    # Example transformation: Filter rows where 'NISS_CMPNY_CD' is not null
    transformed_df = source_df.filter(F.col("NISS_CMPNY_CD").isNotNull())
    
