    transformed_df = source_df.filter(F.col("REC_DROP_IND") != "Y")
    
    # Example transformation: Add a derived column for age group classification
    transformed_df = transformed_df.withColumn(
        "AGE_GROUP",
        F.when(F.col("DERIVED_RDRVR_AGE").cast("int") < 18, "Underage")
         .when((F.col("DERIVED_RDRVR_AGE").cast("int") >= 18) & (F.col("DERIVED_RDRVR_AGE").cast("int") <= 25), "Young Adult")
         .when((F.col("DERIVED_RDRVR_AGE").cast("int") > 25) & (F.col("DERIVED_RDRVR_AGE").cast("int") <= 60), "Adult")
         .otherwise("Senior")
    )
    
    # Example transformation: Aggregate data by 'LOB' and calculate total premium amount
    aggregated_df = transformed_df.groupBy("LOB").agg(
        F.sum("TTL_WRITTN_PREM_AMT").alias("TOTAL_PREMIUM_AMOUNT"),
        F.count("*").alias("RECORD_COUNT")
    )
    
    # Step 3: Write transformed data to Unity Catalog target table
    target_table = "catalog.target_db.NISS_APRM_DETL_TRANSFORMED"
    logger.info(f"Writing transformed data to Unity Catalog target table: {target_table}")
    
    # Drop the target table if it exists
    spark.sql(f"DROP TABLE IF EXISTS {target_table}")
    
    # Write the data in Delta format
    aggregated_df.write.format("delta").mode("overwrite").saveAsTable(target_table)
    logger.info("Data successfully written to Unity Catalog target table")

