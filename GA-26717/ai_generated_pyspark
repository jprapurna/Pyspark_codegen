        """
        logger.info("Routing data")
        insert_df = df.filter(F.col("o_Flag") == "I")
        update_df = df.filter(F.col("o_Flag") == "U")

        log_df_info(insert_df, "Insert Group")
        log_df_info(update_df, "Update Group")

