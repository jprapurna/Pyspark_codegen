def build_report(unit_results, func_results):
    total = len(unit_results) + len(func_results)
    passed = len([r for r in unit_results + func_results if r["status"] == "PASS"])
    failed = len([r for r in unit_results + func_results if r["status"] == "FAIL"])
    errors = len([r for r in unit_results + func_results if r["status"] == "ERROR"])

    def status_color(status):
        return {"PASS": "#c6efce", "FAIL": "#ffc7ce", "ERROR": "#ffeb9c"}.get(status, "#ffffff")

    unit_rows_html = ""
    for r in unit_results:
        unit_rows_html += f"""
        <tr style="background-color:{status_color(r['status'])};">
            <td>{r['suite']}</td>
            <td>{r['name']}</td>
            <td>{r['status']}</td>
            <td>{r['message']}</td>
        </tr>
        """

    func_cards_html = ""
    for r in func_results:
        func_cards_html += f"""
        <div style="border:1px solid #ccc; padding:10px; margin:10px 0; background-color:{status_color(r['status'])};">
            <div><b>Suite:</b> {r['suite']}</div>
            <div><b>Test ID:</b> {r['test_id']}</div>
            <div><b>Scenario:</b> {r['test_scenario']}</div>
            <div><b>Input Data:</b> {r['input_data']}</div>
            <div><b>Expected Result:</b> {r['expected_result']}</div>
            <div><b>Actual Result:</b> {r['actual_result']}</div>
            <div><b>Status:</b> {r['status']}</div>
            <div><b>Message:</b> {r['message']}</div>
        </div>
        """

    html = f"""
    <html>
    <head>
        <style>
            body {{ font-family: Arial, sans-serif; }}
            .summary {{ padding:10px; background:#f2f2f2; margin-bottom:10px; }}
            .tab-button {{ padding:10px; margin-right:5px; cursor:pointer; background:#ddd; border:none; }}
            .tab-content {{ display:none; }}
            .tab-content.active {{ display:block; }}
            table {{ width:100%; border-collapse:collapse; }}
            th, td {{ border:1px solid #ccc; padding:8px; text-align:left; }}
        </style>
        <script>
            function showTab(tabId) {{
                document.getElementById('unit_tab').classList.remove('active');
                document.getElementById('func_tab').classList.remove('active');
                document.getElementById(tabId).classList.add('active');
            }}
        </script>
    </head>
    <body>
        <div class="summary">
            <b>Total:</b> {total} | <b>Passed:</b> {passed} | <b>Failed:</b> {failed} | <b>Errors:</b> {errors}
        </div>
        <button class="tab-button" onclick="showTab('unit_tab')">Unit Tests</button>
        <button class="tab-button" onclick="showTab('func_tab')">Functional Tests</button>

        <div id="unit_tab" class="tab-content active">
            <table>
                <tr><th>Suite</th><th>Test Name</th><th>Status</th><th>Message</th></tr>
                {unit_rows_html}
            </table>
        </div>

        <div id="func_tab" class="tab-content">
            {func_cards_html}
        </div>
    </body>
    </html>
    """
    return html

displayHTML(build_report(unit_results, func_results))

 
