    """
    ETL Pipeline for Group Health Migration
    
    Sources: SRC_MEMBER
    Targets: DIM_PERSON
    Transformation Logic: Extract, transform, and load data with surrogate key generation and domain translation
    """
    
    def __init__(self, spark: SparkSession, config: Dict):
        self.spark = spark
        self.config = config
        self._configure_spark()
    
    def _configure_spark(self):
