        IICS Transformation Logic equivalent
        """
        logger.info("Applying transformations")
        
        # Employer Contribution Percentage Transformation
        df = df.withColumn(
            "EMPLOYER_CONTRIB_PCT",
            F.when(F.col("ER_CONTRIB").isNotNull(),
                   (F.regexp_replace(F.col("ER_CONTRIB"), "%", "").cast("decimal(18,2)") / 100))
            .otherwise(None)
        )
        
        # Employee Contribution Percentage Transformation
        df = df.withColumn(
            "EMPLOYEE_CONTRIB_PCT",
            F.when(F.col("EE_CONTRIB").isNotNull(),
                   (F.regexp_replace(F.col("EE_CONTRIB"), "%", "").cast("decimal(18,2)") / 100))
            .otherwise(F.when(F.col("EMPLOYER_CONTRIB_PCT").isNotNull(),
                              1 - F.col("EMPLOYER_CONTRIB_PCT"))
                       .otherwise(None))
        )
        
        # Base Rate Transformation
        df = df.withColumn(
            "BASE_RATE",
            F.when(F.col("RATE_AMT").isNotNull(),
                   F.regexp_replace(F.col("RATE_AMT"), "[^0-9.]", "").cast("decimal(18,2)"))
