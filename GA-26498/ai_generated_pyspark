            F.broadcast(lookup_df),
            df.DEP_SEQ == lookup_df.DEP_SEQ,
            "left"
        ).withColumn(
            "RELATIONSHIP",
            F.when(F.col("DEP_SEQ") == 0, "SUBSCRIBER")
            .when(F.col("DEP_SEQ") == 1, "SPOUSE")
            .when(F.col("DEP_SEQ") >= 2, "CHILD")
            .otherwise("UNKNOWN")
        ).drop("DEP_SEQ")
        
        return df
    
    def load(self, df: DataFrame):
