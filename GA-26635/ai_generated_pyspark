class CDMRowWidPipeline:
    """
    ETL Pipeline for calculating ROW_WID and inserting into target table.

    Sources: Custom SQL query for lookup.
    Targets: Target table in Delta Lake.
    Transformation Logic: Lookup maximum ROW_WID, calculate new ROW_WID, and insert into target table.
    """

    def __init__(self, spark: SparkSession, config: dict):
        self.spark = spark
        self.config = config
        self._configure_spark()

    def _configure_spark(self):
        """
        Set Spark configurations for optimal performance.
        """
        configs = {
            "spark.sql.adaptive.enabled": "true",
            "spark.sql.adaptive.coalescePartitions.enabled": "true",
            "spark.sql.shuffle.partitions": str(self.config.get('shuffle_partitions', 200)),
            "spark.sql.autoBroadcastJoinThreshold": "10485760"
        }

        for key, value in configs.items():
            self.spark.conf.set(key, value)

    def extract_lookup(self) -> DataFrame:
        """
        Extract lookup data using custom SQL query.

        Returns:
            DataFrame containing ROW_WID and TABLE_NAME.
        """
        logger.info("Extracting lookup data")
        lookup_query = f"""
        SELECT
            NVL(MAX(ROW_WID), 0) AS ROW_WID,
            '{self.config['target_table_name']}' AS TABLE_NAME
        FROM
            {self.config['schema_name']}.{self.config['target_table_name']}
        """
        lookup_df = self.spark.sql(lookup_query)
        log_df_info(lookup_df, "Lookup Data")
        return lookup_df

    def calculate_row_wid(self, lookup_df: DataFrame) -> DataFrame:
        """
        Calculate new ROW_WID based on lookup result.

        Args:
            lookup_df: DataFrame containing lookup data.

        Returns:
            DataFrame with calculated ROW_WID.
        """
        logger.info("Calculating ROW_WID")
        input_df = self.spark.createDataFrame(
            [(self.config['target_table_name'],)],
            ["TGT_TABLE_NAME"]
        )

        # Perform lookup and calculate ROW_WID
        result_df = input_df.join(
            F.broadcast(lookup_df),
            input_df.TGT_TABLE_NAME == lookup_df.TABLE_NAME,
            "left"
        ).select(
            F.col("TGT_TABLE_NAME"),
            F.when(F.col("ROW_WID").isNull(), 0).otherwise(F.col("ROW_WID")).alias("V1")
        ).withColumn(
            "ROW_WID",
            F.col("V1") + 1
        ).select("ROW_WID")

        log_df_info(result_df, "Calculated ROW_WID")
        return result_df

