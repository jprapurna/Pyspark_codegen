        lookup_query = f"""
        SELECT
            NVL(MAX(ROW_WID), 0) AS ROW_WID,
            '{self.config['target_table_name']}' AS TABLE_NAME
        FROM
            {self.config['schema_name']}.{self.config['target_table_name']}
