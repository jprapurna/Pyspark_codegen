from pyspark.sql import functions as F
from pyspark.sql.window import Window
from delta.tables import DeltaTable
import logging

# Initialize logger
logger = logging.getLogger("m_4201_fnd_interactiongroupstatus")
logger.setLevel(logging.INFO)

# Configurations
CATALOG = "interaction_shr_db"
WORK_SCHEMA = "interaction_work_db"
FND_SCHEMA = "interaction_fnd_db"
PARAMS = {
    "$$interaction_work_db": f"{CATALOG}.{WORK_SCHEMA}",
    "$$interaction_fnd_db": f"{CATALOG}.{FND_SCHEMA}",
    "$$IGS_excluded_source": "IGS_excluded_source",
    "$$excluded_sources": "excluded_sources",
    "$$job_cd": "job_cd"
}
BIG_END = F.lit('3500-01-01')
DEC_BIG_END = F.lit(999999999999999999)

# Helper function for parameter substitution
def substitute_params(sql_query, params):
    for key, value in params.items():
        sql_query = sql_query.replace(key, value)
    return sql_query

# Helper function for lookups with fallback
def apply_lookup_with_fallback(df, lookup_table, lookup_key, lookup_value, input_col, output_col, default_value):
    lookup_df = spark.table(lookup_table).select(lookup_key, lookup_value)
    lookup_df = lookup_df.withColumnRenamed(lookup_key, "lkp_key").withColumnRenamed(lookup_value, "lkp_value")
    df = df.join(lookup_df, df[input_col] == lookup_df["lkp_key"], "left_outer")
    df = df.withColumn(output_col, F.coalesce(df["lkp_value"], F.lit(default_value)))
    df = df.drop("lkp_key", "lkp_value")
    return df

# Main mapping function
def run_m_4201_fnd_interactiongroupstatus():
    try:
        # T1 — SQ_InteractionEvent
        logger.info("Starting T1 — SQ_InteractionEvent")
        sql_query = substitute_params("""
            SELECT ROW_NUMBER() OVER (ORDER BY P.InteractionGroup_Id, P.Sequence_It) AS NUMBER_SEQ,
                   P.InteractionGroup_Id,
                   P.BusinessStatus_Cd,
                   P.Status_Cd,
                   P.StatusReason_Cd,
                   P.TransactionEffective_Dt,
                   P.Transaction_Ts,
                   P.Sequence_It,
                   P.Source_Cd,
                   P.LoadEvent_Id
            FROM (
                SELECT VIR_TBL.InteractionGroup_Id AS InteractionGroup_Id,
                       VIR_TBL.BusinessStatus_Cd AS BusinessStatus_Cd,
                       VIR_TBL.Status_Cd AS Status_Cd,
                       VIR_TBL.StatusReason_Cd AS StatusReason_Cd,
                       VIR_TBL.TransactionEffective_Dt AS TransactionEffective_Dt,
                       VIR_TBL.Transaction_Ts AS Transaction_Ts,
                       VIR_TBL.Sequence_It AS Sequence_It,
                       VIR_TBL.Source_Cd AS Source_Cd,
                       VIR_TBL.LoadEvent_Id AS LoadEvent_Id
                FROM $$interaction_work_db.INTERACTIONEVENT IE
                INNER JOIN $$interaction_work_db.LOADEVENT_ID_XREF XREF
                ON TRIM(IE.SOURCE_CD) = TRIM(XREF.Source_Cd)
                AND IE.LOADEVENT_ID = XREF.LOADEVENT_ID
                AND XREF.JOB_CD = $$job_cd
                WHERE XREF.SOURCE_CD NOT IN ('$$excluded_sources', '$$IGS_excluded_source')
                  AND NOT EXISTS (
                      SELECT ''
                      FROM $$interaction_work_db.INTERACTIONEVENT IE2
                      WHERE IE.InteractionGroup_Id = IE2.InteractionGroup_Id
                        AND XREF.Source_cd = IE2.Source_Cd
                        AND IE2.LoadEvent_Id = XREF.LoadEvent_Id
                        AND IE.Sequence_It > IE2.Sequence_it
                        AND IE.Action_Tp = 22
                        AND IE2.Transaction_Tp = 14
                        AND (IE2.Action_Tp = 6 OR IE2.ActionType_Tp = 9 OR IE2.ActionResultDetail_Tp IN (3, 6, 10))
                  )
            ) P
            WHERE P.CURR_ROW <> P.PREV_ROW
              AND NOT EXISTS (
                  SELECT ''
                  FROM $$interaction_fnd_db.INTERACTIONGROUPSTATUS G
                  WHERE G.EXPIRATION_DT = '3500-01-01'
                    AND P.Row_Num = 1
                    AND G.InteractionGroup_Id = P.InteractionGroup_Id
                    AND G.BusinessStatus_Cd = P.BusinessStatus_Cd
                    AND G.Status_Cd = P.Status_Cd
                    AND G.StatusReason_Cd = P.StatusReason_Cd
              )
        """, PARAMS)
        df_sq_interactionevent = spark.sql(sql_query)
        df_sq_interactionevent.createOrReplaceTempView("SQ_InteractionEvent")
        logger.info(f"T1 — SQ_InteractionEvent completed with {df_sq_interactionevent.count()} rows")
        
        # T2 — exp_get_tp_values
        logger.info("Starting T2 — exp_get_tp_values")
        df_exp_get_tp_values = df_sq_interactionevent \
            .withColumn("o_BusinessStatus_Tp", F.lit(-2)) \
            .withColumn("o_Status_Tp", F.lit(-2)) \
            .withColumn("o_StatusReason_Tp", F.lit(-2)) \
            .withColumn("o_InteractionGroupStatus_Id", F.expr("CAST(LoadEvent_Id AS STRING) || LPAD(CAST(NUMBER_SEQ AS STRING), 18, '0')"))
        df_exp_get_tp_values.createOrReplaceTempView("exp_get_tp_values")
        logger.info(f"T2 — exp_get_tp_values completed with {df_exp_get_tp_values.count()} rows")
        
        # T3 — exp_set_default_Tp_values
        logger.info("Starting T3 — exp_set_default_Tp_values")
        df_exp_set_default_tp_values = df_exp_get_tp_values \
            .withColumn("o_BusinessStatus_Tp", F.when(F.col("BusinessStatus_Tp").isNotNull(), F.col("BusinessStatus_Tp")).otherwise(F.lit(-2))) \
            .withColumn("o_Status_Tp", F.when(F.col("Status_Tp").isNotNull(), F.col("Status_Tp")).otherwise(F.lit(-2))) \
            .withColumn("o_StatusReason_Tp", F.when(F.col("StatusReason_Tp").isNotNull(), F.col("StatusReason_Tp")).otherwise(F.lit(-2)))
        df_exp_set_default_tp_values.createOrReplaceTempView("exp_set_default_Tp_values")
        logger.info(f"T3 — exp_set_default_Tp_values completed with {df_exp_set_default_tp_values.count()} rows")
        
        # T4 — Write to InteractionGroupStatus
        logger.info("Starting T4 — Write to InteractionGroupStatus")
        target_fqn = f"{CATALOG}.{FND_SCHEMA}.InteractionGroupStatus"
        target_cols = ["InteractionGroupStatus_Id", "InteractionGroup_Id", "BusinessStatus_Cd", "BusinessStatus_Tp", "Status_Cd", "Status_Tp", "StatusReason_Cd", "StatusReason_Tp", "Effective_Dt", "Expiration_Dt", "Transaction_Ts", "Revision_Ts", "SequenceStart_It", "SequenceEnd_It", "Source_Cd", "LoadEvent_Id"]
        df_final = df_exp_set_default_tp_values.selectExpr(*target_cols)
        DeltaTable.forName(spark, target_fqn).alias("target").merge(
            df_final.alias("updates"),
            "target.InteractionGroupStatus_Id = updates.InteractionGroupStatus_Id"
        ).whenMatchedUpdateAll().whenNotMatchedInsertAll().execute()
        logger.info(f"T4 — Write to InteractionGroupStatus completed")
    except Exception as e:
        logger.exception(f"Error in mapping m_4201_fnd_interactiongroupstatus: {str(e)}")
        raise

# Run the mapping
run_m_4201_fnd_interactiongroupstatus()