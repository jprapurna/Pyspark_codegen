from pyspark.sql import functions as F
from pyspark.sql.utils import AnalysisException
import logging

# Initialize logger
logger = logging.getLogger("m_3202_dt_chn_baseinteractiongroup")
logger.setLevel(logging.INFO)

# Configuration
CATALOG = "BaseInteractionGroup"
WORK_SCHEMA = "interaction_work_db"
FND_SCHEMA = "interaction_fnd_db"
PARAMS = {
    "$$interaction_work_db": f"{CATALOG}.{WORK_SCHEMA}",
    "$$interaction_fnd_db": f"{CATALOG}.{FND_SCHEMA}"
}
BIG_END = F.lit('3500-01-01')
DEC_BIG_END = F.lit(350036535003659999)

def run_m_3202_dt_chn_baseinteractiongroup():
    """
    Executes the mapping logic for m_3202_dt_chn_baseinteractiongroup.
    """
    try:
        # T1 — SQ_Override_DateChain
        logger.info("Starting T1: SQ_Override_DateChain")
        sql_query = f"""
        SELECT
            O.BaseInteractionGroup_Id,
            O.InteractionGroup_Id,
            O.Source_Cd,
            O.NewExpiration_Dt,
            O.NewRevision_Ts,
            O.NewSequenceEnd_It
        FROM (
            SELECT
                BaseInteractionGroup_Id,
                InteractionGroup_Id,
                Source_Cd,
                COALESCE(
                    MIN(Effective_Dt) OVER (
                        PARTITION BY InteractionGroup_Id
                        ORDER BY Effective_Dt ASC, SequenceStart_It ASC
                        ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING
                    ),
                    DATE '3500-01-01'
                ) AS NewExpiration_Dt,
                COALESCE(
                    MIN(Transaction_Ts) OVER (
                        PARTITION BY InteractionGroup_Id
                        ORDER BY Transaction_Ts ASC, SequenceStart_It ASC
                        ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING
                    ),
                    TIMESTAMP '3500-01-01 00:00:00.000000'
                ) AS NewRevision_Ts,
                COALESCE(
                    MIN(SequenceStart_It) OVER (
                        PARTITION BY InteractionGroup_Id
                        ORDER BY SequenceStart_It ASC
                        ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING
                    ),
                    350036535003659999
                ) AS NewSequenceEnd_It
            FROM {PARAMS["$$interaction_fnd_db"]}.BaseInteractionGroup tgt
            WHERE EXISTS (
                SELECT 1
                FROM {PARAMS["$$interaction_work_db"]}.Saf_BaseInteractionGroup tgt1
                WHERE tgt.InteractionGroup_Id = tgt1.InteractionGroup_Id
                  AND tgt.Source_Cd = tgt1.Source_Cd
            )
            QUALIFY NOT (
                Expiration_Dt = NewExpiration_Dt
                AND Revision_Ts = NewRevision_Ts
                AND SequenceEnd_It = NewSequenceEnd_It
            )
        ) O
        """
        df_t1 = spark.sql(sql_query)
        df_t1.createOrReplaceTempView("SQ_Override_DateChain")
        logger.info(f"T1 completed: row_count={df_t1.count()}, schema={df_t1.schema}")
        df_t1.limit(5).show(truncate=False)

        # T2 — Target Write
        logger.info("Starting T2: Target Write")
        target_fqn = f"{CATALOG}.{FND_SCHEMA}.BaseInteractionGroup"
        target_cols = [
            "BaseInteractionGroup_Id", "InteractionGroup_Id", "Source_Cd",
            "NewExpiration_Dt", "NewRevision_Ts", "NewSequenceEnd_It"
        ]
        df_final = df_t1.select(*target_cols)
        try:
            # Ensure target table exists
            spark.sql(f"CREATE TABLE IF NOT EXISTS {target_fqn} USING DELTA AS SELECT * FROM SQ_Override_DateChain WHERE 1=0")
        except AnalysisException as e:
            logger.warning(f"Table creation failed: {e}")

        # Write to target table
        from delta.tables import DeltaTable
        delta_table = DeltaTable.forName(spark, target_fqn)
        delta_table.alias("target").merge(
            df_final.alias("source"),
            "target.BaseInteractionGroup_Id = source.BaseInteractionGroup_Id AND target.InteractionGroup_Id = source.InteractionGroup_Id"
        ).whenMatchedUpdateAll().whenNotMatchedInsertAll().execute()
        logger.info(f"T2 completed: Data written to {target_fqn}")

    except Exception as e:
        logger.exception(f"Error in mapping execution: {e}")
        raise


