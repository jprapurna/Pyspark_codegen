        logger.info("Executing T1: SQ_SAF_BaseInteractiongroup_for_get_min_date")
        sql_query_t1 = f"""
        SELECT
            InteractionGroup_Id,
            MAX(KeepSequence_It) OVER (PARTITION BY InteractionGroup_Id ORDER BY SequenceStart_It, LoadEvent_Id ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS SequenceStart_It,
            Effective_Dt,
            MAX(KeepLoadEvent_It) OVER (PARTITION BY InteractionGroup_Id ORDER BY SequenceStart_It, LoadEvent_Id ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS LoadEvent_Id
        FROM (
            SELECT
                InteractionGroup_Id,
                SequenceStart_It,
                Effective_Dt,
                Rank_It,
                LoadEvent_Id,
                COALESCE(Rank_It - SUM(Rank_It) OVER (PARTITION BY InteractionGroup_Id ORDER BY SequenceStart_It, LoadEvent_Id ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING), Rank_It) AS Rank_Diff,
                CASE WHEN Rank_Diff <> 0 THEN SequenceStart_It END AS KeepSequence_It,
                CASE WHEN Rank_Diff <> 0 THEN LoadEvent_Id END AS KeepLoadEvent_It
            FROM (
                SELECT
                    InteractionGroup_Id,
                    SequenceStart_It,
                    Effective_Dt,
                    LoadEvent_Id,
                    RANK() OVER (PARTITION BY InteractionGroup_Id ORDER BY Chksum_BaseInteractionGroup) AS Rank_It
                FROM {PARAMS["$$interaction_work_db"]}.saf_baseinteractiongroup
                WHERE LoadFlag_BaseInteractionGroup <> 'I'
            ) rankbaseinteractiongroup
        ) ranksequence
