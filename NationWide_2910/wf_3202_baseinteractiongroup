            {PARAMS["$$interaction_work_db"]}.SAF_BaseInteractionGroup SAF 
        LEFT OUTER JOIN
            {PARAMS["$$interaction_fnd_db"]}.BaseInteractionGroup FND
        ON 
            SAF.InteractionGroup_Id = FND.InteractionGroup_Id 
            AND SAF.Source_Cd = FND.Source_Cd
