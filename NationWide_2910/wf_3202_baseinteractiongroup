def apply_lookup_with_fallback(df, lookup_table, key_col, lookup_col, default_value):
    """Perform a left join lookup and fallback to default value if not found."""
    lookup_df = spark.table(lookup_table).select(key_col, lookup_col)
    return df.join(lookup_df, df[key_col] == lookup_df[key_col], "left_outer") \
             .withColumn(lookup_col, F.coalesce(F.col(lookup_col), F.lit(default_value)))

