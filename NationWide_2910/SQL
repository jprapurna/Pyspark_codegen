from pyspark.sql import SparkSession
from pyspark.sql.functions import col, lit, row_number, current_timestamp, max
from pyspark.sql.window import Window
import traceback

def step1700():
    """STEP1700 - PySpark Equivalent of BTEQ STEP1700
    
    Purpose:
        Inserts new rows into NDW_XT.BIL_RegistrationStatType_Id_Xt by selecting Agent_Active_Flag,
        calculating RegistrationStatusType_Id, and adding a load timestamp. Filters out rows where
        Agent_Active_Flag already exists in the target table.
    
    Summary of BTEQ Commands:
        - SQL INSERT with SELECT and WHERE NOT IN logic
        - Error handling with .IF ERRORCODE <> 0 THEN SET ERRORCODE = -999999
        - SIGNAL SQLSTATE '45000' for SQL error state
        - COLLECT STATISTICS on the target table
        - EXPORT REPORT for logging the next step
    """
    # Initialize Spark session
    spark = SparkSession.builder.appName("STEP1700").enableHiveSupport().getOrCreate()

    # Initialize variables
    ndw_type = "ndw_type"
    NDW_XT = "ndw_xt"
    INFILE = "/mnt/output/STEP1700_log"  # Simulate BTEQ file export
    ERRORCODE = 0  # Track error status as in BTEQ

    try:
        print("Starting STEP1700 execution...")
        print(f"Source Database: {NDW_XT}, Target Database: {ndw_type}")

        # Read source tables
        src_df = spark.table(f"{NDW_XT}.BIL_RegistrationStatType_Id_Xt")
        incr_df = spark.table(f"WORKDB_BILLING.TZ5BO_INCR")

        # Filter new records using left_anti join
        new_records_df = incr_df.join(
            src_df.select("Agent_Active_Flag"),
            on="Agent_Active_Flag",
            how="left_anti"
        )

        # Calculate RegistrationStatusType_Id and add load timestamp
        max_id = src_df.select(max("RegistrationStatusType_Id")).collect()[0][0] or 0
        window_spec = Window.orderBy("Agent_Active_Flag")
        transformed_df = new_records_df.select(
            col("Agent_Active_Flag"),
            (lit(max_id) + row_number().over(window_spec)).alias("RegistrationStatusType_Id"),
            current_timestamp().alias("load_ts")
        )

        # Insert into target table
        transformed_df.write.mode("append").saveAsTable(f"{NDW_XT}.BIL_RegistrationStatType_Id_Xt")

        # Log record count
        inserted_count = transformed_df.count()
        print(f"Inserted {inserted_count} new records into {NDW_XT}.BIL_RegistrationStatType_Id_Xt")

        # Collect statistics on the target table
        try:
            print("Collecting statistics on NDW_XT.BIL_RegistrationStatType_Id_Xt...")
            spark.sql("ANALYZE TABLE NDW_XT.BIL_RegistrationStatType_Id_Xt COMPUTE STATISTICS FOR COLUMNS Agent_Active_Flag")
            print("Statistics collected successfully.")
        except Exception as stats_error:
            ERRORCODE = -999999
            print(f"Error during statistics collection: {str(stats_error)}")
            raise Exception("SIGNAL SQLSTATE '45000' - Collect Statistics Failed")

        # Export restart report
        try:
            export_df = spark.sql("SELECT '.GOTO STEP1800 --insert into ndw_type.RegistrationStatusType' AS Title")
            export_df.write.mode("append").saveAsTable(INFILE)
