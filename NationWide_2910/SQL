            col("Diary_Entry_Flag"),
            (lit(max_input_method_type_id) + row_number().over(window_spec)).alias("InputMethodType_Id"),
            current_timestamp().alias("load_ts")
        )

        # Insert into target table
        transformed_df.write.mode("append").saveAsTable(f"{NDW_XT}.BIL_InputMethodType_Id_XT")

        # Log record count
        inserted_count = transformed_df.count()
        print(f"Inserted {inserted_count} new records into {NDW_XT}.BIL_InputMethodType_Id_XT")

        # Collect statistics
        try:
            print("Collecting statistics on NDW_XT.BIL_InputMethodType_Id_XT...")
            spark.sql("ANALYZE TABLE NDW_XT.BIL_InputMethodType_Id_XT COMPUTE STATISTICS FOR COLUMNS Diary_Entry_Flag")
