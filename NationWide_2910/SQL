        - Error handling with .IF ERRORCODE <> 0 THEN SET ERRORCODE = -999999
        - SIGNAL SQLSTATE '45000' for failure
        - COLLECT STATISTICS on NDW_XT.BIL_InputMethodType_Id_XT for DIARY_ENTRY_FLAG index
        - EXPORT REPORT DDNAME=INFILE for logging
    """
    spark = SparkSession.builder.appName("STEP6400").enableHiveSupport().getOrCreate()
    ndw_type = "ndw_type"
