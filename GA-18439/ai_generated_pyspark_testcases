class CustomerTransactionAgg:
    """
    ETL Pipeline for Customer Transaction Aggregation
    Source: Raw customer transactions from bronze layer
    Target: Aggregated customer metrics in gold layer
    Transformation Logic:
    - Standardize columns
    - Apply business rules
    - Lookup enrichment
    - Deduplication
    - Aggregation
    """

    def __init__(self, spark: SparkSession, config: Dict):
        self.spark = spark
        self.config = config
        self._configure_spark()

    # -------------------------------------------------
    # Spark configuration
    # -------------------------------------------------
    def _configure_spark(self):
        configs = {
            "spark.sql.adaptive.enabled": "true",
            "spark.sql.adaptive.coalescePartitions.enabled": "true",
            "spark.sql.shuffle.partitions": str(
                self.config.get("shuffle_partitions", 200)
            )
        }
        for k, v in configs.items():
            self.spark.conf.set(k, v)

    # -------------------------------------------------
    # Extract
    # -------------------------------------------------
    def extract(self) -> DataFrame:
        logger.info(f"Extracting data from {self.config['source_path']}")

        df = (
            self.spark.read
            .format(self.config.get("source_format", "parquet"))
            .load(self.config["source_path"])
            .filter(F.col("txn_date") >= self.config["start_date"])
            .select(*self.config["required_columns"])
        )

        logger.info(f"Extracted {df.count()} records")
        return df

    # -------------------------------------------------
    # Transform
    # -------------------------------------------------
    def transform(self, df: DataFrame) -> DataFrame:
        logger.info("Starting transformations")

        df = (
            df.transform(self._standardize_columns)
              .transform(self._apply_business_rules)
              .transform(self._deduplicate_transactions)
              .transform(self._enrich_with_customer_dim)
              .transform(self._aggregate_metrics)
              .transform(self._apply_data_quality)
        )

        logger.info(f"Transformation completed: {df.count()} records")
        return df

    # -------------------------------------------------
    # Standardization
    # -------------------------------------------------
    def _standardize_columns(self, df: DataFrame) -> DataFrame:
        return df.select(
            F.col("customer_id").cast("long").alias("customer_id"),
            F.upper(F.trim(F.col("customer_name"))).alias("customer_name"),
            F.col("txn_amount").cast("decimal(18,2)").alias("amount"),
            F.to_date("txn_date").alias("txn_date")
        )

    # -------------------------------------------------
    # Business rules
    # -------------------------------------------------
    def _apply_business_rules(self, df: DataFrame) -> DataFrame:
        return (
            df.withColumn(
                "txn_category",
                F.when(F.col("amount") >= 10000, "HIGH")
                 .when(F.col("amount") >= 1000, "MEDIUM")
                 .otherwise("LOW")
            )
            .withColumn(
                "is_valid",
                (F.col("amount") > 0) & F.col("customer_name").isNotNull()
            )
        )

    # -------------------------------------------------
    # Deduplication
    # -------------------------------------------------
    def _deduplicate_transactions(self, df: DataFrame) -> DataFrame:
        win = Window.partitionBy(
            "customer_id", "txn_date", "amount"
        ).orderBy(F.col("txn_date").desc())

        return (
            df.withColumn("rn", F.row_number().over(win))
              .filter(F.col("rn") == 1)
              .drop("rn")
        )

    # -------------------------------------------------
    # Lookup enrichment
    # -------------------------------------------------
    def _enrich_with_customer_dim(self, df: DataFrame) -> DataFrame:
        dim_df = self.spark.read.table(self.config["customer_dim_table"])

        return (
            df.join(
                F.broadcast(dim_df.select("customer_id", "region")),
                on="customer_id",
                how="left"
            )
        )

    # -------------------------------------------------
    # Aggregation
    # -------------------------------------------------
    def _aggregate_metrics(self, df: DataFrame) -> DataFrame:
        return (
            df.groupBy("customer_id", "region", "txn_category", "txn_date")
              .agg(
                  F.sum("amount").alias("total_amount"),
                  F.count("*").alias("txn_count"),
                  F.avg("amount").alias("avg_amount")
              )
        )

    # -------------------------------------------------
    # Data quality
    # -------------------------------------------------
    def _apply_data_quality(self, df: DataFrame) -> DataFrame:
        return df.filter(F.col("total_amount") > 0)

    # -------------------------------------------------
    # Load
    # -------------------------------------------------
    def load(self, df: DataFrame):
        logger.info(f"Loading data to {self.config['target_path']}")

        (
            df.write
              .format("delta")
              .mode(self.config.get("write_mode", "overwrite"))
              .partitionBy(*self.config.get("partition_columns", []))
              .option("overwriteSchema", "true")
              .save(self.config["target_path"])
        )

        if self.config.get("optimize_target", True):
            self.spark.sql(
                f"""
                OPTIMIZE delta.`{self.config['target_path']}`
                ZORDER BY ({', '.join(self.config.get('zorder_columns', []))})
                """
            )

        logger.info("Load completed successfully")

    # -------------------------------------------------
    # Execute
    # -------------------------------------------------
    def execute(self):
        logger.info(f"Starting ETL pipeline: {self.__class__.__name__}")

        try:
            src_df = self.extract()
            tgt_df = self.transform(src_df)
            self.load(tgt_df)
            logger.info("ETL pipeline finished successfully")
        except Exception as e:
            logger.exception("ETL pipeline failed")
            raise


